# Server
PORT=8088
# Host port docker-compose publishes (left side of host:container). Defaults to 8088.
APP_PORT=8088

# Database (Neon PostgreSQL — keep sslmode=require)
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/toolbox?sslmode=require

# File storage
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_UPLOAD_SIZE_MB=50
MAX_MERGE_FILES=10

# Cleanup scheduler
CLEANUP_INTERVAL=10m
FILE_RETENTION=1h

# Currency service
FX_PROVIDER_URL=https://api.frankfurter.dev
FX_CACHE_TTL=30m
FX_STALE_WINDOW=6h
FX_WARMUP_EVERY=30m
FX_WARMUP_LIMIT=30
FX_HTTP_TIMEOUT=8s
# 12 months
FX_HISTORY_KEEP=8760h

# Rate limiting (per IP)
RATE_LIMIT_RPM=60
RATE_LIMIT_WINDOW=1m
